# ── Embedding ────────────────────────────────────────────────────────────────
# Name of the Sentence Transformers model to use for query embeddings.
# See: https://www.sbert.net/docs/pretrained_models.html
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Semantic Cache ───────────────────────────────────────────────────────────
# Float between 0.0 and 1.0. Queries with cosine similarity >= this value
# will be treated as a cache hit.
SIMILARITY_THRESHOLD=0.85

# File names for persisted FAISS index and metadata (stored in data/)
FAISS_INDEX_FILE=cache.faiss
CACHE_METADATA_FILE=cache_metadata.json

# SQLite database file for request logs (stored in data/)
LOG_DB_FILE=cache_logs.db

# ── Hybrid Search (Vector + BM25) ──────────────────────────────────────────────
# When true, cache lookups blend FAISS cosine similarity with BM25 keyword
# scoring instead of relying on vector similarity alone. Off by default.
ENABLE_HYBRID_SEARCH=false

# Relative weight given to the vector score vs. the BM25 score when blending.
# hybrid_score = VECTOR_WEIGHT * cosine_similarity + BM25_WEIGHT * bm25_norm
VECTOR_WEIGHT=0.6
BM25_WEIGHT=0.4

# Number of top candidates each retriever (FAISS, BM25) contributes to the
# merged candidate pool before ranking.
HYBRID_TOP_K=10

# Float between 0.0 and 1.0. Minimum blended hybrid score to accept a cache
# hit when ENABLE_HYBRID_SEARCH=true. Distinct from SIMILARITY_THRESHOLD
# because it is measured on a different scale.
HYBRID_SIMILARITY_THRESHOLD=0.55

# ── Multi-Modal Caching (Image + Audio) ────────────────────────────────────────
# CLIP model used to embed IMAGE queries. Produces a different vector space
# and dimension than EMBEDDING_MODEL, so image queries always get their own
# SemanticCache instance/index — see src/modality.py.
IMAGE_EMBEDDING_MODEL=clip-ViT-B-32

# File names for the image cache's persisted FAISS index and metadata
# (stored in data/) — deliberately separate from FAISS_INDEX_FILE/
# CACHE_METADATA_FILE above.
IMAGE_FAISS_INDEX_FILE=image_cache.faiss
IMAGE_CACHE_METADATA_FILE=image_cache_metadata.json

# OpenAI Whisper model used to transcribe AUDIO queries to text before
# caching them exactly like a TEXT query.
AUDIO_TRANSCRIPTION_MODEL=whisper-1

# ── Cache Eviction (TTL + LRU) ──────────────────────────────────────────────────
# Time-to-live, in seconds: entries older than this (measured from when they
# were cached) are pruned automatically. 0 disables TTL pruning (entries
# never expire on their own). Example: 604800 = 7 days.
CACHE_TTL_SECONDS=0

# Maximum number of entries to retain. Once exceeded, the least-recently-used
# entries (by last cache HIT, not insertion order) are evicted until the
# cache fits again. 0 disables the cap (unbounded growth).
CACHE_MAX_SIZE=0

# ── OpenAI / LLM ─────────────────────────────────────────────────────────────
# Your OpenAI API key — NEVER commit the real value to version control.
OPENAI_API_KEY=sk-...your-key-here...

# Which OpenAI chat model to use on a cache miss.
OPENAI_MODEL=gpt-4o-mini

# Maximum number of retry attempts on transient LLM API errors.
LLM_MAX_RETRIES=3

# ── LLM Provider ─────────────────────────────────────────────────────────────
# Which backend LLMClient talks to on a cache miss: "openai", "huggingface",
# or "groq". All three speak the same OpenAI-compatible wire format, so
# switching only changes which key/model below is used. (Audio transcription
# always uses OPENAI_API_KEY above, regardless of this setting.)
LLM_PROVIDER=openai

# Hugging Face Inference Providers — used when LLM_PROVIDER=huggingface.
# Create a token at https://huggingface.co/settings/tokens (a "Read" token
# is enough); most accounts get some free monthly inference credit — see
# https://huggingface.co/settings/billing. NEVER commit the real value.
HF_API_KEY=hf_...your-token-here...

# Any chat model id listed on https://router.huggingface.co (open-weight
# models across multiple providers). Must be vision-capable too if you want
# to use it for image queries in the Multi-Modal Playground.
HF_MODEL=meta-llama/Llama-3.1-8B-Instruct

# Groq — used when LLM_PROVIDER=groq. Create a free key at
# https://console.groq.com/keys (no credit card required). Free tier is
# rate-limited (~30 req/min, ~1,000 req/day per model) but otherwise $0.
# NEVER commit the real value.
GROQ_API_KEY=gsk_...your-key-here...

# Any chat model id listed at https://console.groq.com/docs/models.
GROQ_MODEL=llama-3.3-70b-versatile

# ── Logging ───────────────────────────────────────────────────────────────────
# Log verbosity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Max size (bytes) of a single log file before rotation  (default: 5 MB)
LOG_MAX_BYTES=5242880

# Number of rotated log backup files to keep
LOG_BACKUP_COUNT=3
